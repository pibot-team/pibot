# 한국관광공사 TourAPI (공공데이터포털)
TOUR_API_KEY=

# 기상청 단기예보 (공공데이터포털) - backend
KMA_API_KEY=

# 카카오 REST API 키 (로컬, 모빌리티) - backend
KAKAO_REST_API_KEY=

# LLM - ai
ANTHROPIC_API_KEY=

# DB (로컬은 docker-compose의 db)
DATABASE_URL=postgresql://pibot:pibot@localhost:5432/pibot

# 서버 간 호출 (backend <-> ai). 둘이 같은 값
INTERNAL_API_KEY=
BACKEND_URL=http://localhost:8080
AI_URL=http://localhost:8000
