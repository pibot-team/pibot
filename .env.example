# 공공데이터포털 인증키 (계정당 하나, 아래 API 전부 이 키로 호출)
# - 한국관광공사 국문 관광정보 서비스 (TourAPI)
# - 기상청 단기예보 조회서비스
# - 한국천문연구원 출몰시각 정보
DATA_GO_KR_KEY=

# 비짓제주 오픈API - ai (장소 데이터, RAG 색인)
VISITJEJU_API_KEY=

# 카카오 REST API 키 (로컬, 모빌리티) - backend
KAKAO_REST_API_KEY=

# LLM - ai
ANTHROPIC_API_KEY=

# DB (로컬은 docker-compose의 db)
DATABASE_URL=postgresql://pibot:pibot@localhost:5432/pibot

# 서버 간 호출 (backend <-> ai). 둘이 같은 값
INTERNAL_API_KEY=
BACKEND_URL=http://localhost:8080
AI_URL=http://localhost:8000
