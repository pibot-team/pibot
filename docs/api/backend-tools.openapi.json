{
  "openapi": "3.1.0",
  "info": {
    "title": "Pibot Backend Tools",
    "description": "Spring 백엔드가 구현하고 AI 서버가 호출한다. 요청 헤더에 X-Internal-Key 필요.",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/tools/travel-time": {
      "post": {
        "summary": "두 지점 사이 이동시간과 거리",
        "operationId": "get_travel_time",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TravelTimeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TravelTimeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/tools/optimize-route": {
      "post": {
        "summary": "고른 장소들의 방문 순서와 도착 시각을 정한다",
        "operationId": "optimize_route",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizeRouteIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizeRouteOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/tools/weather": {
      "post": {
        "summary": "시간대별 강수확률과 강수량",
        "operationId": "get_weather",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WeatherIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/tools/parking": {
      "post": {
        "summary": "근처 주차장과 걸어가는 시간",
        "operationId": "find_parking",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkingIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParkingOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/internal/tools/place-detail": {
      "post": {
        "summary": "장소 상세: 영업시간, 휴무, 주차, 설명",
        "operationId": "get_place_detail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceDetailIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Day": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/Stop"
            },
            "type": "array",
            "title": "Stops"
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/Leg"
            },
            "type": "array",
            "title": "Legs"
          }
        },
        "type": "object",
        "required": [
          "date",
          "stops"
        ],
        "title": "Day"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HourlyWeather": {
        "properties": {
          "hour": {
            "type": "integer",
            "title": "Hour"
          },
          "rain_prob": {
            "type": "integer",
            "title": "Rain Prob"
          },
          "rain_mm": {
            "type": "number",
            "title": "Rain Mm"
          },
          "temp_c": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Temp C"
          }
        },
        "type": "object",
        "required": [
          "hour",
          "rain_prob",
          "rain_mm"
        ],
        "title": "HourlyWeather"
      },
      "LatLng": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "LatLng"
      },
      "Leg": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "car",
              "transit",
              "walk"
            ],
            "title": "Mode",
            "default": "car"
          },
          "minutes": {
            "type": "integer",
            "title": "Minutes"
          }
        },
        "type": "object",
        "required": [
          "minutes"
        ],
        "title": "Leg",
        "description": "stops[i] -> stops[i + 1] 이동."
      },
      "OpeningHours": {
        "properties": {
          "open": {
            "type": "string",
            "format": "time",
            "title": "Open"
          },
          "close": {
            "type": "string",
            "format": "time",
            "title": "Close"
          }
        },
        "type": "object",
        "required": [
          "open",
          "close"
        ],
        "title": "OpeningHours"
      },
      "OptimizeRouteIn": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "start_at": {
            "type": "string",
            "format": "time",
            "title": "Start At"
          },
          "start_point": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LatLng"
              },
              {
                "type": "null"
              }
