          },
          "end_point": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LatLng"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "car",
              "transit",
              "walk"
            ],
            "title": "Mode",
            "default": "car"
          },
          "stops": {
            "items": {
              "$ref": "#/components/schemas/RouteStop"
            },
            "type": "array",
            "title": "Stops"
          }
        },
        "type": "object",
        "required": [
          "date",
          "start_at",
          "stops"
        ],
        "title": "OptimizeRouteIn",
        "description": "고른 장소들의 방문 순서와 도착 시각을 정한다."
      },
      "OptimizeRouteOut": {
        "properties": {
          "day": {
            "$ref": "#/components/schemas/Day"
          },
          "total_travel_minutes": {
            "type": "integer",
            "title": "Total Travel Minutes"
          },
          "unplaced": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unplaced"
          }
        },
        "type": "object",
        "required": [
          "day",
          "total_travel_minutes"
        ],
        "title": "OptimizeRouteOut"
      },
      "ParkingIn": {
        "properties": {
          "point": {
            "$ref": "#/components/schemas/LatLng"
          },
          "radius_m": {
            "type": "integer",
            "title": "Radius M",
            "default": 500
          }
        },
        "type": "object",
        "required": [
          "point"
        ],
        "title": "ParkingIn"
      },
      "ParkingLot": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          },
          "walk_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Walk Minutes"
          },
          "fee": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fee"
          },
          "hours": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hours"
          }
        },
        "type": "object",
        "required": [
          "name",
          "lat",
          "lng"
        ],
        "title": "ParkingLot"
      },
      "ParkingOut": {
        "properties": {
          "lots": {
            "items": {
              "$ref": "#/components/schemas/ParkingLot"
            },
            "type": "array",
            "title": "Lots"
          }
        },
        "type": "object",
        "required": [
          "lots"
        ],
        "title": "ParkingOut"
      },
      "Place": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "title": "Lng"
          },
          "category": {
            "anyOf": [
