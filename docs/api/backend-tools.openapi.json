      "TravelTimeIn": {
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/LatLng"
          },
          "dest": {
            "$ref": "#/components/schemas/LatLng"
          },
          "mode": {
            "type": "string",
            "enum": [
              "car",
              "transit",
              "walk"
            ],
            "title": "Mode",
